{
  "manifest_version": 3,
  "name": "ASCII Wallpapers for claude.ai",
  "version": "0.1.1",
  "description": "Sixteen live ASCII wallpapers behind your claude.ai chats. Type /theme in the message box, or press Alt+T.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "ASCII 壁纸（Alt+T）",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
